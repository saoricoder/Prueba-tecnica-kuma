# Archivo de configuración de ejemplo
# Copia como .env y personaliza según tu entorno

# Entorno: development, testing, production
ENVIRONMENT=development

# Debug: True o False
DEBUG=True

# Base de datos
DATABASE_URL=sqlite:///./gestion_tareas.db
DATABASE_NAME=gestion_tareas.db

# Clave secreta (cambiar en producción)
SECRET_KEY=dev-secret-key-change-in-production

# Logging
LOG_LEVEL=INFO

# CORS Origins (separados por comas para producción)
# CORS_ORIGINS=https://frontend.com,https://api.example.com
